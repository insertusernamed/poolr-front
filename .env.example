# Copy this file to `.env` (or `.env.local`) and adjust as needed.
#
# Base URL of the Poolr backend API.
# - Local development with the bundled vite proxy: leave empty or omit.
#   Vite proxies /api/* to the backend, see vite.config.js -> server.proxy
# - Pointing directly at a backend (e.g. deployed): set the full base URL.
#   Example: https://kiwiportal.duckdns.org/poolr
VITE_API_BASE_URL=

# NOTE: PayPal credentials are NOT configured here. The frontend fetches the
# PayPal client-id from the backend at /api/payments/paypal/config.
